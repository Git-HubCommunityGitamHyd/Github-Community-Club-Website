{
  "name": "github-community-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "wrangler d1 execute github-community-db --local --file=db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute github-community-db --remote --file=db/schema.sql",
    "db:patch:local": "wrangler d1 execute github-community-db --local --file",
    "db:patch:remote": "wrangler d1 execute github-community-db --remote --file",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/without-local-env.mjs opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "node scripts/without-local-env.mjs opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "build:doodles": "node scripts/build-doodle-pattern.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.511.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-use-measure": "^2.1.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wrangler": "^4.136.1"
  }
}
