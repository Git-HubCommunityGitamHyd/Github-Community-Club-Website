{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "github-community-website",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "github-community-website",
    },
    // The upload signer. Called through this binding, never its workers.dev
    // URL: same-account Worker-to-Worker fetches over workers.dev are blocked.
    {
      "binding": "SIGN_WORKER",
      "service": "gh-community-cloudinary-sign",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-community-db",
      "database_id": "643dddeb-d49f-4560-8e0e-fe310950f7c6",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
