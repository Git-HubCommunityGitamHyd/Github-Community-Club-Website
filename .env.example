ADMIN_PASSWORD=choose-a-long-random-password
SESSION_SECRET=run-openssl-rand--hex-32-and-paste-here

# The secret first path segment the CMS is served under: the CMS is at
# /<ADMIN_PATH>, and /admin is a decoy. 16 to 64 lowercase letters, digits or
# dashes. Generate with `openssl rand -hex 12`. Unset, the CMS is unreachable.
# Share it with maintainers privately; never commit, link or tweet it.
ADMIN_PATH=run-openssl-rand--hex-12-and-paste-here

# Image uploads (board members / events) — Cloudinary storage, signed by the
# workers/cloudinary-sign Worker. /api/admin/upload-sign calls the Worker
# server-to-server with this shared secret; the Worker holds the matching
# WORKER_SHARED_SECRET plus CLOUDINARY_API_KEY/CLOUDINARY_API_SECRET as its
# own `wrangler secret put` values, never exposed here.
UPLOAD_SIGN_URL=http://localhost:8787/sign
WORKER_SHARED_SECRET=run-openssl-rand--hex-32-and-paste-here
